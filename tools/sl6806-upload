#!/usr/bin/env python3
"""
sl6806-upload - load a payload build into RAM and run it.

Wraps smtlink_dump, which does the actual USB work:

    smtlink_dump init simple_exec <base> <image.bin>

`init` puts the boot ROM into the state where it accepts RAM writes, and
`simple_exec` writes the image to <base> and jumps to <base>|1 (Thumb).

The device must be in BOOTLOADER mode: power off, hold a button, plug in USB.
Which button varies by unit - it is trial and error. Card-reader mode looks
similar over USB but will not run payloads, so this checks the mode first
instead of letting the load fail in a confusing way.
"""

import argparse
import os
import shutil
import string
import subprocess
import sys

DEFAULT_BASE = 0x820000

# SCSI INQUIRY identity, as (vendor, product). Confirmed against the device;
# the typos are the firmware's, not ours. Bootloader mode is the one that
# accepts payloads.
#
# These are compared against the *decoded* fields, not against the text
# smtlink_dump prints. Matching its output as a string does not work: it
# prints a hexdump whose ASCII column renders 0x20 as ".", and the T10 vendor
# field ends at byte 15 - a line boundary - so "SMTLINK DEVICE" is split
# across two lines and never appears literally. A substring check therefore
# fails on a perfectly good device, and, worse, silently never fires for the
# card-reader case it exists to catch.
BOOTLOADER_ID = ("SMTLINK", "DEVICE")
CARDREADER_ID = ("SSTLINK", "DDVICE")


def find_tool(explicit):
    if explicit:
        return explicit
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "..", "3rd", "smartlink_flash", "smtlink_dump"),
        shutil.which("smtlink_dump") or "",
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return os.path.abspath(c)
    sys.exit("error: smtlink_dump not found. Build 3rd/smartlink_flash "
             "(run make there), or pass --tool <path>.")


def run(tool, args, sudo, capture=False):
    cmd = ([  "sudo"] if sudo else []) + [tool] + args
    if capture:
        return subprocess.run(cmd, capture_output=True, text=True)
    return subprocess.run(cmd)


def parse_hexdump(text):
    """Reassemble the bytes from smtlink_dump's hexdump output.

    Each data line is hex byte columns, optionally followed by "|ascii|".
    Lines that are not purely hex bytes (headers, warnings) are skipped, so
    this survives the tool printing anything else alongside.
    """
    data = bytearray()
    for line in text.splitlines():
        row = line.split("|", 1)[0].strip()
        if not row:
            continue
        toks = row.split()
        if not all(len(t) == 2 and all(c in string.hexdigits for c in t)
                   for t in toks):
            continue
        data += bytes(int(t, 16) for t in toks)
    return bytes(data)


def parse_inquiry(text):
    """(vendor, product, revision) from a SCSI INQUIRY response, or None.

    Standard field layout: bytes 8-15 vendor, 16-31 product, 32-35 revision.
    """
    data = parse_hexdump(text)
    if len(data) < 36:
        return None
    def field(lo, hi):
        return data[lo:hi].decode("latin-1").strip()
    return field(8, 16), field(16, 32), field(32, 36)


def check_mode(tool, sudo, chip_args):
    """Refuse clearly if the device is not in bootloader mode."""
    r = run(tool, chip_args + ["inquiry"], sudo, capture=True)
    text = (r.stdout or "") + (r.stderr or "")

    ident = parse_inquiry(text)
    if ident is None:
        print("warning: could not read an inquiry response; continuing\n"
              "         anyway. If this hangs, the device is probably not in\n"
              "         bootloader mode.", file=sys.stderr)
        return

    vendor, product, rev = ident

    if (vendor, product) == CARDREADER_ID:
        sys.exit(
            "error: the device is in CARD READER mode, not bootloader mode.\n"
            "       (inquiry says %s %s %s)\n"
            "       Payloads only run from bootloader mode. Power the device\n"
            "       off, hold a button, and plug the USB cable back in while\n"
            "       still holding it. The button varies between units."
            % (vendor, product, rev))

    if (vendor, product) != BOOTLOADER_ID:
        print("warning: unrecognised device: inquiry says %s %s %s, expected\n"
              "         %s %s. Continuing anyway."
              % (vendor, product, rev, *BOOTLOADER_ID), file=sys.stderr)
        return

    print("bootloader mode confirmed (%s %s %s)" % (vendor, product, rev))


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("image", help="payload .bin from the build")
    p.add_argument("--base", type=lambda s: int(s, 0), default=DEFAULT_BASE,
                   help="load address (default 0x%x, must match the linker "
                        "script)" % DEFAULT_BASE)
    p.add_argument("--tool", help="path to smtlink_dump")
    p.add_argument("--no-sudo", action="store_true",
                   help="do not prefix with sudo (use if you installed the "
                        "udev rules from 3rd/smartlink_flash/README.md)")
    p.add_argument("--no-init", action="store_true",
                   help="skip the init command")
    p.add_argument("--skip-check", action="store_true",
                   help="do not probe the USB mode first")
    args = p.parse_args()

    if not os.path.isfile(args.image):
        sys.exit("error: no such file: %s" % args.image)

    size = os.path.getsize(args.image)
    if size == 0:
        sys.exit("error: %s is empty" % args.image)
    if size > 0x10000:
        sys.exit("error: %s is %d bytes, which overflows the 64 KiB payload "
                 "window at 0x%x" % (args.image, size, args.base))

    tool = find_tool(args.tool)
    sudo = not args.no_sudo

    # SL6806 must be selected explicitly: the tool otherwise infers the chip
    # from the USB serial, and one of the two SL6806 serials is commented out
    # in its source, so inference can land on "unknown chip".
    chip_args = ["chip", "6806"]

    if not args.skip_check:
        check_mode(tool, sudo, chip_args)

    cmd = list(chip_args)
    if not args.no_init:
        cmd.append("init")
    cmd += ["simple_exec", hex(args.base), args.image]

    print("uploading %s (%d bytes) to 0x%x" % (args.image, size, args.base))
    r = run(tool, cmd, sudo)
    if r.returncode != 0:
        sys.exit("error: smtlink_dump failed (exit %d).\n"
                 "       If it reported a pipe/stall error, the device is\n"
                 "       most likely not in bootloader mode." % r.returncode)

    print("running. Use `make monitor` to see its output.")


if __name__ == "__main__":
    main()
