#!/usr/bin/env python3
"""
sl6806-monitor - interactive serial monitor for a running SL6806 sketch.

There is no UART to open. The sketch answers a vendor SCSI command from
inside the boot ROM's USB loop; this drives that command with the stock
smtlink_dump. See cores/sl6806/sl6806_console.h for the protocol.

    tools/sl6806-monitor build/Blink.sym

Output is fetched one USB round trip per poll, and the device reports how many
bytes were lost if polling fell behind - those show up as a [lost N bytes]
marker rather than a silently corrupted stream.

Anything you type is sent to the sketch's Serial.read(). Ctrl-C to quit.

The device must still be in bootloader mode with the sketch resident. Without
--send or typed input, this only reads.
"""

import argparse
import os
import re
import select
import struct
import sys
import termios
import time
import tty

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from sl6806_dev import Device as BaseDevice, find_tool     # noqa: E402

MAGIC = 0x36384C53          # "SL68"
VERSION = 2
POLL_ADDR = 0x434F4E53      # "CONS" - the console-poll sentinel

# struct sl6806_console_t header: magic,size,version,head,tail,dropped,
#                                 rx_head,rx_tail
HDR_FMT = "<IIIIIIII"
HDR_LEN = struct.calcsize(HDR_FMT)

# struct sl6806_console_pkt_t: len,flags,pending,data[60]
PKT_FMT = "<BBH60s"
PKT_LEN = struct.calcsize(PKT_FMT)

F_OVERFLOW = 0x01
RX_SIZE = 256


# Consecutive failed console polls before the monitor explains itself.
STALL_AFTER = 15


def report_stall(dev, base):
    """Say why the console went quiet, and separate the two possible causes.

    A failed console poll and a failed plain read mean different things. The
    console poll is the only command that runs loop() (in RUN_MODE=poll), so
    if plain reads still work, loop() is what is breaking the transaction -
    which is a sketch problem, not a dead link.
    """
    why = dev.last_error or "no reason reported"
    alive = dev.read(base, HDR_LEN) is not None

    print("\n[no console output for %d polls: %s]" % (STALL_AFTER, why),
          file=sys.stderr)
    if alive:
        print("[but plain memory reads still work, so the device is up and\n"
              " _start ran. In RUN_MODE=poll the console poll is the only\n"
              " command that runs loop() inside the boot ROM's USB handler -\n"
              " so it is loop() breaking this transaction. Shorten it:\n"
              "   make ... RUN_MODE=poll EXTRA_FLAGS=-DSL6806_POLL_BLOCK_LIMIT_MS=1\n"
              " tools/sl6806-calibrate probes the same handler without ever\n"
              " running loop(), which confirms this independently.]\n",
              file=sys.stderr)
    else:
        print("[plain memory reads fail too, so the link itself is down.\n"
              " Unplug, hold the boot key, plug back in, and upload again.\n"
              " Nothing here writes to flash, so there is nothing to repair.]\n",
              file=sys.stderr)


def console_addr_from_sym(path):
    """Read the console address from the .sym file the build emits."""
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"([0-9a-fA-F]+)\s+\S+\s+_sl6806_console", line)
                if m:
                    return int(m.group(1), 16)
    except OSError as e:
        sys.exit("error: %s" % e)
    sys.exit("error: no _sl6806_console symbol in %s (was the sketch built by "
             "this framework?)" % path)


class Device(BaseDevice):
    def poll_console(self):
        """One round trip: fetch and consume queued output.

        Returns (data, overflowed, pending) or None if the device did not
        answer."""
        raw = self.read(POLL_ADDR, PKT_LEN)
        if raw is None or len(raw) != PKT_LEN:
            return None
        n, flags, pending, data = struct.unpack(PKT_FMT, raw)
        if n > 60:
            return None
        return data[:n], bool(flags & F_OVERFLOW), pending


def push_input(dev, base, hdr_size, text):
    """Append bytes to the rx ring, then publish them by bumping rx_head."""
    payload = text.encode() if isinstance(text, str) else text
    if not payload:
        return True
    if len(payload) > RX_SIZE:
        payload = payload[-RX_SIZE:]

    hdr = dev.read(base, HDR_LEN)
    if hdr is None:
        return False
    magic, size, version, _h, _t, _d, rx_head, rx_tail = struct.unpack(HDR_FMT, hdr)
    if magic != MAGIC:
        return False

    # Do not overrun input the sketch has not consumed yet.
    if (rx_head - rx_tail) + len(payload) > RX_SIZE:
        return False

    rx_off = base + hdr_size + size
    pos = rx_head % RX_SIZE

    if pos + len(payload) <= RX_SIZE:
        ok = dev.write(rx_off + pos, payload)
    else:
        split = RX_SIZE - pos
        ok = (dev.write(rx_off + pos, payload[:split]) and
              dev.write(rx_off, payload[split:]))
    if not ok:
        return False

    # rx_head is the 7th u32 in the header.
    return dev.write(base + 24, struct.pack("<I", rx_head + len(payload)))


def describe_absence(hdr, base, last_error):
    """Why there is no console yet - the two cases mean different things.

    A device that does not answer at all is a link problem. A device that
    answers with something that is not the console magic is a healthy device
    with no sketch in it, which is what you get every time you replug: SRAM
    does not survive, so the payload has to be uploaded again. Telling a user
    to check the cable when they simply have not uploaded wastes a session.
    """
    if hdr is None:
        return ("the device is not answering: %s\n"
                " Is it plugged in and in bootloader mode? (unplug, hold the\n"
                " boot key, plug back in)" % (last_error or "no reason given"))
    magic = struct.unpack_from("<I", hdr)[0]
    return ("the device answers, but there is no sketch resident: the console\n"
            " magic at 0x%08x reads 0x%08x, not 0x%08x. Unplugging clears\n"
            " SRAM, so upload again:  make SKETCH=<sketch> upload"
            % (base, magic, MAGIC))


def wait_for_console(dev, base, quiet):
    """Block until the sketch has published a valid console header."""
    warned = None
    while True:
        hdr = dev.read(base, HDR_LEN)
        if hdr is not None:
            magic, size, version = struct.unpack_from("<III", hdr)
            if magic == MAGIC:
                if version != VERSION:
                    sys.exit("error: sketch console is v%d, this monitor "
                             "speaks v%d - rebuild the sketch"
                             % (version, VERSION))
                return size
        why = describe_absence(hdr, base, dev.last_error)
        # Re-announce if the situation changes - "not answering" turning into
        # "no sketch" is progress and worth seeing.
        if why != warned and not quiet:
            print("(%s)" % why, file=sys.stderr)
            warned = why
        time.sleep(0.3)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("sym", help="the .sym file emitted next to the build")
    p.add_argument("--tool", help="path to smtlink_dump")
    p.add_argument("--no-sudo", action="store_true")
    p.add_argument("--interval", type=float, default=0.1,
                   help="seconds between polls when idle (default 0.1)")
    p.add_argument("--send", metavar="TEXT",
                   help="send TEXT (plus newline) once, then keep monitoring")
    p.add_argument("--no-input", action="store_true",
                   help="do not forward what you type to the sketch")
    p.add_argument("--duration", type=float, metavar="SECONDS",
                   help="exit cleanly after SECONDS instead of running until "
                        "ctrl-c. Use this for scripted runs: killing the "
                        "monitor with a signal can land in the middle of a "
                        "USB transaction and desynchronise the endpoint, "
                        "which wedges the device until it is power cycled.")
    p.add_argument("--idle-exit", type=float, metavar="SECONDS",
                   help="exit once the device has produced no output for "
                        "SECONDS. Handy when a sketch prints a finite report "
                        "and then goes quiet.")
    args = p.parse_args()

    base = console_addr_from_sym(args.sym)
    dev = Device(find_tool(args.tool), not args.no_sudo)

    print("monitoring console at 0x%08x (ctrl-c to quit)" % base,
          file=sys.stderr)

    size = wait_for_console(dev, base, quiet=False)

    if args.send is not None:
        if not push_input(dev, base, HDR_LEN, args.send + "\n"):
            print("(send failed)", file=sys.stderr)

    interactive = (not args.no_input) and sys.stdin.isatty()
    old_termios = None
    if interactive:
        old_termios = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())

    pending_in = b""
    misses = 0
    started = time.time()
    last_output = started

    try:
        while True:
            if args.duration is not None and time.time() - started >= args.duration:
                break
            if (args.idle_exit is not None
                    and time.time() - last_output >= args.idle_exit):
                print("[no output for %.0f s; exiting]" % args.idle_exit,
                      file=sys.stderr)
                break

            got = dev.poll_console()

            if got is None:
                misses += 1
                # Retrying in silence is how a wedged device presents as "the
                # monitor just sits there", which is the least informative
                # symptom there is. Say what is happening, once per outage.
                if misses == STALL_AFTER:
                    report_stall(dev, base)
                time.sleep(args.interval)
                continue

            if misses >= STALL_AFTER:
                print("[device answering again after %d failed polls]\n"
                      % misses, file=sys.stderr)
            misses = 0

            data, overflowed, pending = got

            if overflowed:
                sys.stdout.write("\n[lost output - device outran the poll "
                                 "rate]\n")

            if data:
                last_output = time.time()
                sys.stdout.write(data.decode("utf-8", errors="replace"))
                sys.stdout.flush()

            # Collect anything typed, without blocking the poll loop.
            if interactive:
                while select.select([sys.stdin], [], [], 0)[0]:
                    ch = os.read(sys.stdin.fileno(), 1)
                    if not ch:
                        break
                    pending_in += b"\n" if ch == b"\r" else ch

            if pending_in:
                if push_input(dev, base, HDR_LEN, pending_in):
                    pending_in = b""
                # else: the sketch's input buffer is full; retry next poll.

            # Keep fetching without pausing while output is still queued.
            if pending == 0 and not data:
                time.sleep(args.interval)

    except KeyboardInterrupt:
        print(file=sys.stderr)
    finally:
        if old_termios is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_termios)


if __name__ == "__main__":
    main()
