#!/usr/bin/env python3
"""
sl6806-monitor - interactive serial monitor for a running SL6806 sketch.

There is no UART to open. The sketch answers a vendor SCSI command from
inside the boot ROM's USB loop; this drives that command with the stock
smtlink_dump. See cores/sl6806/sl6806_console.h for the protocol.

    tools/sl6806-monitor build/Blink.sym

Output is fetched one USB round trip per poll, and the device reports how many
bytes were lost if polling fell behind - those show up as a [lost N bytes]
marker rather than a silently corrupted stream.

Anything you type is sent to the sketch's Serial.read(). Ctrl-C to quit.

The device must still be in bootloader mode with the sketch resident. Without
--send or typed input, this only reads.
"""

import argparse
import os
import select
import struct
import sys
import termios
import time
import tty

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from sl6806_dev import (Device, find_tool, symbol, parse_console_header,   # noqa: E402
                        HDR_FMT, HDR_LEN, RX_SIZE, VERSION)


def push_input(dev, base, hdr_size, text):
    """Append bytes to the rx ring, then publish them by bumping rx_head."""
    payload = text.encode() if isinstance(text, str) else text
    if not payload:
        return True
    if len(payload) > RX_SIZE:
        payload = payload[-RX_SIZE:]

    hdr = dev.read(base, HDR_LEN)
    if parse_console_header(hdr) is None:
        return False
    _m, size, _v, _h, _t, _d, rx_head, rx_tail = struct.unpack(HDR_FMT, hdr)

    # Do not overrun input the sketch has not consumed yet.
    if (rx_head - rx_tail) + len(payload) > RX_SIZE:
        return False

    rx_off = base + hdr_size + size
    pos = rx_head % RX_SIZE

    if pos + len(payload) <= RX_SIZE:
        ok = dev.write(rx_off + pos, payload)
    else:
        split = RX_SIZE - pos
        ok = (dev.write(rx_off + pos, payload[:split]) and
              dev.write(rx_off, payload[split:]))
    if not ok:
        return False

    # rx_head is the 7th u32 in the header.
    return dev.write(base + 24, struct.pack("<I", rx_head + len(payload)))


def wait_for_console(dev, base, quiet):
    """Block until the sketch has published a valid console header."""
    warned = False
    while True:
        got = parse_console_header(dev.read(base, HDR_LEN))
        if got is not None:
            size, version = got
            if version != VERSION:
                sys.exit("error: sketch console is v%d, this monitor "
                         "speaks v%d - rebuild the sketch"
                         % (version, VERSION))
            return size
        if not warned and not quiet:
            print("(waiting for the device - is it in bootloader mode with "
                  "the sketch loaded?)", file=sys.stderr)
            warned = True
        time.sleep(0.3)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("sym", help="the .sym file emitted next to the build")
    p.add_argument("--tool", help="path to smtlink_dump")
    p.add_argument("--no-sudo", action="store_true")
    p.add_argument("--interval", type=float, default=0.1,
                   help="seconds between polls when idle (default 0.1)")
    p.add_argument("--send", metavar="TEXT",
                   help="send TEXT (plus newline) once, then keep monitoring")
    p.add_argument("--no-input", action="store_true",
                   help="do not forward what you type to the sketch")
    args = p.parse_args()

    base = symbol(args.sym, "_sl6806_console")
    dev = Device(find_tool(args.tool), not args.no_sudo)

    print("monitoring console at 0x%08x (ctrl-c to quit)" % base,
          file=sys.stderr)

    size = wait_for_console(dev, base, quiet=False)

    if args.send is not None:
        if not push_input(dev, base, HDR_LEN, args.send + "\n"):
            print("(send failed)", file=sys.stderr)

    interactive = (not args.no_input) and sys.stdin.isatty()
    old_termios = None
    if interactive:
        old_termios = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())

    pending_in = b""

    try:
        while True:
            got = dev.poll_console()

            if got is None:
                time.sleep(args.interval)
                continue

            data, overflowed, pending = got

            if overflowed:
                sys.stdout.write("\n[lost output - device outran the poll "
                                 "rate]\n")

            if data:
                sys.stdout.write(data.decode("utf-8", errors="replace"))
                sys.stdout.flush()

            # Collect anything typed, without blocking the poll loop.
            if interactive:
                while select.select([sys.stdin], [], [], 0)[0]:
                    ch = os.read(sys.stdin.fileno(), 1)
                    if not ch:
                        break
                    pending_in += b"\n" if ch == b"\r" else ch

            if pending_in:
                if push_input(dev, base, HDR_LEN, pending_in):
                    pending_in = b""
                # else: the sketch's input buffer is full; retry next poll.

            # Keep fetching without pausing while output is still queued.
            if pending == 0 and not data:
                time.sleep(args.interval)

    except KeyboardInterrupt:
        print(file=sys.stderr)
    finally:
        if old_termios is not None:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_termios)


if __name__ == "__main__":
    main()
