#!/usr/bin/env python3
"""
sl6806-romclocks - extract the mask ROM's *second* clock family.

WHY THIS EXISTS. docs/sl6806_re_notes.md 15b established the module clock
space: 128 ids across four gate/shadow register pairs, enabled shadow-then-
gate-then-poll. This project has treated that as the clock tree ever since,
and it is not the whole of it.

The camera's own sensor_init (0x00D44CBC) calls the SRAM veneer 0x008051EC
with 58, and that veneer branches into ROM 0x20EC - an 85-entry `tbh`
dispatcher where each id sets one bit in one CRU register. Entry 58 is
`0x400800C0 |= 1`. Nothing in this repository had ever written that register,
or any of the fifty-five others this table reaches.

    tools/sl6806-romclocks maskrom.bin
    tools/sl6806-romclocks maskrom.bin --header cores/sl6806/sl6806_romclk.h

WHAT THE TABLE LOOKS LIKE. Every implemented entry is the same five
instructions - load a base, load an offset from it, OR in one immediate,
store it back, return - so the extraction is exact rather than heuristic. Ids
that dispatch to 0x24BE are the default arm: unimplemented, and reported as
such rather than silently skipped.

WHAT IS NOT KNOWN. What any of them clocks. The ids are not in the flash
image except at call sites, and only two are attributed: 58 is the camera
sensor's, from sensor_init, and 73 sets CRU +0x118, which 0x00D44688 also
programs as the camera's module clock. The rest are a map with no legend,
which is still worth having - the module ids had no legend either until
examples/Buttons walked them and found the ADC.
"""

import argparse
import re
import struct
import subprocess
import sys
import tempfile
import os

TABLE = 0x20F6          # the tbh table, just past the dispatcher at 0x20EC
COUNT = 85              # the `cmp r0, #84` bound
UNIMPLEMENTED = 0x24BE  # the default arm every unused id branches to


def decode_entry(rom, target):
    """Pull (base, offset, bit) out of one dispatcher arm.

    The shape is fixed:
        ldr  r2, [pc, #n]     ; the peripheral base
        ldr  r3, [r2, #off]
        orr  r3, r3, #bit
        str  r3, [r2, #off]
        bx   lr
    Anything that does not match returns None rather than a guess.
    """
    with tempfile.NamedTemporaryFile(suffix='.bin', delete=False) as f:
        f.write(rom[target:target + 0x18])
        path = f.name
    try:
        out = subprocess.run(
            ['arm-none-eabi-objdump', '-D', '-b', 'binary', '-m', 'arm',
             '-M', 'force-thumb', '--adjust-vma=0x%X' % target, path],
            capture_output=True, text=True).stdout
    finally:
        os.unlink(path)

    lit = re.search(r'ldr\s+r2, \[pc, #\d+\].*?@ \(0x([0-9a-f]+)\)', out)
    off = re.search(r'(?:ldr|ldr\.w)\s+r3, \[r2, #(\d+)\]', out)
    orr = re.search(r'orr(?:\.w)?\s+r3, r3, #(\d+)', out)
    if not (lit and off and orr):
        return None

    base = struct.unpack_from('<I', rom, int(lit.group(1), 16))[0]
    return base, int(off.group(1)), int(orr.group(1))


def read_table(rom):
    """Yield (id, target, decoded-or-None) for every dispatcher entry."""
    for i in range(COUNT):
        entry = struct.unpack_from('<H', rom, TABLE + 2 * i)[0]
        target = TABLE + 2 * entry
        if target == UNIMPLEMENTED:
            yield i, target, None
            continue
        yield i, target, decode_entry(rom, target)


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('rom', help='maskrom.bin')
    ap.add_argument('--header', metavar='FILE', help='write a C header')
    args = ap.parse_args()

    rom = open(args.rom, 'rb').read()
    if len(rom) < TABLE + 2 * COUNT:
        sys.exit('error: %s is too small to be the mask ROM' % args.rom)

    rows = list(read_table(rom))
    good = [(i, d) for i, _t, d in rows if d]
    print('%d of %d ids implemented' % (len(good), COUNT))
    for i, target, dec in rows:
        if dec:
            print('  id %2d  0x%08X+0x%02X |= 0x%X' % (i, dec[0], dec[1], dec[2]))
        else:
            print('  id %2d  unimplemented (0x%04X)' % (i, target))

    if not args.header:
        return

    with open(args.header, 'w') as f:
        f.write('/*\n'
                ' * sl6806_romclk.h - GENERATED by tools/sl6806-romclocks.'
                ' Do not edit.\n'
                ' *\n'
                ' * The mask ROM\'s second clock family, from the dispatcher at ROM\n'
                ' * 0x20EC. 15b\'s 128 module ids are one mechanism; these are\n'
                ' * another, and nothing in this project had touched them until the\n'
                ' * camera\'s sensor_init turned out to call id 58.\n'
                ' *\n'
                ' * Transcribed rather than called: the veneer the application uses\n'
                ' * (0x008051EC) is not resident in bootloader mode, and each entry\n'
                ' * is one OR into one register, which is trivial to perform here.\n'
                ' *\n'
                ' * WHAT EACH ONE CLOCKS IS UNKNOWN. Two are attributed: 58 is the\n'
                ' * camera sensor\'s (0x00D44CD8) and 73 sets CRU +0x118, which is\n'
                ' * also the camera module clock 0x00D44688 programs. The rest are a\n'
                ' * map with no legend - which is exactly what the module ids were\n'
                ' * before they were walked.\n'
                ' *\n'
                ' * Regenerate with:\n'
                ' *     tools/sl6806-romclocks maskrom.bin \\\n'
                ' *         --header cores/sl6806/sl6806_romclk.h\n'
                ' */\n'
                '#ifndef SL6806_ROMCLK_H\n'
                '#define SL6806_ROMCLK_H\n'
                '\n'
                '#include <stdint.h>\n'
                '\n'
                'typedef struct {\n'
                '    uint8_t  id;\n'
                '    uint32_t addr;\n'
                '    uint32_t bit;\n'
                '} sl6806_romclk_t;\n'
                '\n')
        f.write('#define SL6806_ROMCLK_COUNT  %d\n\n' % len(good))
        f.write('static const sl6806_romclk_t sl6806_romclk[] = {\n')
        for i, dec in good:
            f.write('    { %2d, 0x%08Xu, 0x%08Xu },\n'
                    % (i, dec[0] + dec[1], dec[2]))
        f.write('};\n\n')
        f.write('/* [V] The one the camera sensor\'s own init enables. */\n'
                '#define SL6806_ROMCLK_SENSOR  58\n'
                '\n#endif /* SL6806_ROMCLK_H */\n')
    print('wrote %s: %d entries' % (args.header, len(good)))


if __name__ == '__main__':
    main()
