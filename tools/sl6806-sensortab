#!/usr/bin/env python3
"""
sl6806-sensortab - lift the camera sensor's init tables out of the flash image.

WHY THIS EXISTS. The sc101 sensor needs ~200 register writes before it
produces anything, and nobody has a datasheet for it. The vendor's tables are
the only source, they are plain {reg, value} bytes in FIRM, and a payload
cannot read them at run time - a payload runs from SRAM in bootloader mode
with no XIP mapping - so they have to be compiled in.

    tools/sl6806-sensortab dump.bin                  # describe both tables
    tools/sl6806-sensortab dump.bin --decode         # ...with the paging resolved
    tools/sl6806-sensortab dump.bin --header sc101_init.h

THE FORMAT, from the writer at 0x00D44C50. Byte pairs, `FF FF` terminated,
each pair sent as one 2-byte I2C write to address 0x68 with ~40 us between
them. Register 0xF0 is a page selector: it sets the high byte of a 16-bit
register number, so `F0=32` then `03=78` means register 0x3203 = 0x78. The
writer neither knows nor cares - it is the sensor that pages - which is why
the table can be replayed verbatim by anything that can write two bytes.

WHICH TABLE. The init routine picks by its argument: 1 selects table B, and
anything else table A.

    A  0x00C7DA51  192 pairs  full 1280x720 array
    B  0x00C7DBD3  203 pairs  a centred 648x488 crop - VGA

Table B's crop block is what sizes the sensor, and it decodes exactly:
0x3200/0x3202 start at (320, 120), 0x3204/0x3206 end at (967, 607), so
648x488 inside a 1280x720 array. --decode prints it.

The two are adjacent: A's terminator is B's first byte minus two. That is the
cheapest possible check that the addresses are right, and it is asserted.
"""

import argparse
import struct
import sys

FLASH_BASE = 0x00C00000
TABLE_A = 0x00C7DA51
TABLE_B = 0x00C7DBD3
TERMINATOR = (0xFF, 0xFF)
MAX_PAIRS = 512          # a runaway guard; both real tables are ~200

# [V] The crop window registers, 0x00C7DBD3's tail and 7h's decode.
CROP = {0x3200: 'x start', 0x3202: 'y start', 0x3204: 'x end', 0x3206: 'y end'}


def read_table(fw, addr):
    """Walk one FF FF terminated {reg, value} table."""
    off = addr - FLASH_BASE
    if not (0 <= off < len(fw)):
        sys.exit('error: 0x%08X is outside the image' % addr)
    pairs = []
    while len(pairs) < MAX_PAIRS:
        reg, val = fw[off], fw[off + 1]
        if (reg, val) == TERMINATOR:
            return pairs, addr + 2 * len(pairs) + 2
        pairs.append((reg, val))
        off += 2
    sys.exit('error: no terminator within %d pairs at 0x%08X' % (MAX_PAIRS, addr))


def paged(pairs):
    """Resolve register 0xF0 into 16-bit register numbers.

    Yields (reg16, value, page) with page carried from the last 0xF0 write.
    The page starts at 0 because that is where the sensor comes up and where
    the writer leaves it.
    """
    page = 0
    for reg, val in pairs:
        if reg == 0xF0:
            page = val
            continue
        yield (page << 8) | reg, val, page


def describe(fw, name, addr):
    pairs, end = read_table(fw, addr)
    print('table %s at 0x%08X: %d pairs, terminator at 0x%08X'
          % (name, addr, len(pairs), end - 2))

    crop = {}
    for reg16, val, _page in paged(pairs):
        if reg16 in CROP:
            crop[reg16] = val
        elif reg16 - 1 in CROP:
            crop[reg16 - 1] = (crop.get(reg16 - 1, 0) << 8) | val

    if len(crop) == 4:
        x0, y0, x1, y1 = (crop[0x3200], crop[0x3202], crop[0x3204], crop[0x3206])
        print('  crop x %d..%d (%d wide), y %d..%d (%d tall)'
              % (x0, x1, x1 - x0 + 1, y0, y1, y1 - y0 + 1))
    else:
        print('  no crop block - the full array')
    return pairs, end


def emit_header(fw, path):
    a, a_end = read_table(fw, TABLE_A)
    b, _ = read_table(fw, TABLE_B)

    with open(path, 'w') as f:
        f.write('/*\n'
                ' * sc101_init.h - GENERATED by tools/sl6806-sensortab. Do not edit.\n'
                ' *\n'
                ' * The vendor\'s two init tables for the sc101 sensor, lifted from\n'
                ' * this unit\'s own flash. Byte pairs, {register, value}, written in\n'
                ' * order to I2C 0x68 with ~40 us between them; register 0xF0 selects\n'
                ' * the high byte of a 16-bit register number. See\n'
                ' * docs/sl6806_re_notes.md 7h and the tool\'s own header.\n'
                ' *\n'
                ' * Regenerate with:\n'
                ' *     tools/sl6806-sensortab dump.bin --header \\\n'
                ' *         examples/CameraDemo/sc101_init.h\n'
                ' */\n'
                '#ifndef SC101_INIT_H\n'
                '#define SC101_INIT_H\n'
                '\n'
                '#include <stdint.h>\n'
                '\n'
                '/* [V] The writer\'s pacing, 0x00D44C50: 40 us between pairs. */\n'
                '#define SC101_WRITE_GAP_US   40\n'
                '\n'
                '/* [V] After the terminator the vendor optionally writes this pair,\n'
                ' * gated on a global at 0x008299CA - a flip/mirror bit. */\n'
                '#define SC101_FLIP_REG       0x21\n'
                '#define SC101_FLIP_VAL       0x06\n')

        for name, addr, pairs, note in (
                ('A', TABLE_A, a, 'the full 1280x720 array'),
                ('B', TABLE_B, b, 'a centred 648x488 window - VGA')):
            f.write('\n/* [V] Table %s, flash 0x%08X, %d pairs - %s. */\n'
                    % (name, addr, len(pairs), note))
            f.write('#define SC101_TABLE_%s_PAIRS  %d\n' % (name, len(pairs)))
            f.write('static const uint8_t sc101_table_%s[][2] = {\n' % name)
            for i in range(0, len(pairs), 6):
                row = pairs[i:i + 6]
                f.write('    ' + ' '.join('{0x%02X, 0x%02X},' % p for p in row) + '\n')
            f.write('};\n')

        f.write('\n#endif /* SC101_INIT_H */\n')

    print('wrote %s: table A %d pairs, table B %d pairs'
          % (path, len(a), len(b)))
    return a_end


def main():
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('dump')
    ap.add_argument('--decode', action='store_true',
                    help='print every write with its 16-bit register number')
    ap.add_argument('--header', metavar='FILE', help='write a C header')
    args = ap.parse_args()

    fw = open(args.dump, 'rb').read()

    a_pairs, a_end = describe(fw, 'A', TABLE_A)
    b_pairs, _ = describe(fw, 'B', TABLE_B)

    # The two tables are adjacent in the image. If that stops being true the
    # addresses are wrong, or this is a different firmware build.
    if a_end != TABLE_B:
        print('WARNING: table A ends at 0x%08X, not at table B (0x%08X) - the'
              ' addresses may not fit this image' % (a_end, TABLE_B))
    else:
        print('table A ends exactly where table B begins - the addresses fit')

    if args.decode:
        for name, pairs in (('A', a_pairs), ('B', b_pairs)):
            print('\ntable %s, paged:' % name)
            for reg16, val, _page in paged(pairs):
                mark = '   <- %s' % CROP[reg16] if reg16 in CROP else ''
                print('  0x%04X = 0x%02X%s' % (reg16, val, mark))

    if args.header:
        emit_header(fw, args.header)


if __name__ == '__main__':
    main()
