#!/usr/bin/env python3
"""
sl6806-checkdump - tell you whether a flash dump is actually a flash dump.

A failed SL6806 dump does not look like an error. The tool exits 0 and writes
a file of exactly the size you asked for, but the device answered every read
with whatever was already in its USB buffer. The result is a plausible-looking
binary full of repeated SCSI replies. Run this before spending any time
analysing a dump.

    tools/sl6806-checkdump dump.bin
    tools/sl6806-checkdump --rom  maskrom.bin      # from sl6806-dumpram
    tools/sl6806-checkdump --sram sram.bin

Checks, in order of how much time they save you:
  1. Is the whole file one short block repeated? (the classic failed dump)
  2. Does it start with the HLKJ bootloader magic?
  3. Do the HLKJ header and payload CRC16s verify?
  4. Is the partition table where it should be, naming FIRM/PICS/FONT?
  5. Is the size right for this chip? (SL6806 is 4 MiB)

--rom and --sram check memory dumps instead, which fail differently: they can
come back as plausible noise rather than as a repeated block. The tests are
the ones used to establish that the reference dumps were trustworthy
(docs/sl6806_re_notes.md 7f):

  ROM  - do its own BL/BLX branches resolve inside it? Real code is
         overwhelmingly self-referential; a shifted or garbage image is not.
  SRAM - is the relocated vector table at 0x00800000 full of ROM-range
         pointers, and does the ROM's stack below 0x00806000 hold ROM-range
         return addresses? Those two regions prove the read addressed SRAM
         correctly, which is what lets you believe an *absence* elsewhere.
"""

import argparse
import hashlib
import sys

FLASH_SIZE = 4 * 1024 * 1024
ROM_SIZE = 0x7D000
SRAM_SIZE = 0x40000
HLKJ_MAGIC = b"HLKJ"
PART_TABLE_OFF = 0x0F000


def crc16_ccitt_false(buf, crc=0xFFFF):
    """poly 0x1021, init 0xFFFF, no reflection, no final xor."""
    for b in buf:
        crc ^= b << 8
        for _ in range(8):
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
    return crc


class Report:
    def __init__(self):
        self.fatal = False

    def ok(self, msg):
        print("  \033[32mok\033[0m    %s" % msg)

    def warn(self, msg):
        print("  \033[33mwarn\033[0m  %s" % msg)

    def bad(self, msg):
        print("  \033[31mFAIL\033[0m  %s" % msg)
        self.fatal = True


def bl_targets(data, base):
    """Yield every 32-bit BL/BLX target. Shared with tools/sl6806-ramcalls."""
    import struct
    for off in range(0, len(data) - 4, 2):
        w1, w2 = struct.unpack_from("<HH", data, off)
        if (w1 & 0xF800) != 0xF000:
            continue
        if (w2 & 0xD000) == 0xD000:
            blx = False
        elif (w2 & 0xD000) == 0xC000:
            blx = True
        else:
            continue
        sgn = (w1 >> 10) & 1
        i1 = (~((w2 >> 13 & 1) ^ sgn)) & 1
        i2 = (~((w2 >> 11 & 1) ^ sgn)) & 1
        imm = (sgn << 24) | (i1 << 23) | (i2 << 22) | \
              ((w1 & 0x3FF) << 12) | ((w2 & 0x7FF) << 1)
        if sgn:
            imm -= 1 << 25
        pc = base + off + 4
        if blx:
            pc &= ~3
            imm &= ~3
        yield pc + imm


def check_rom(data, r):
    """A mask ROM dump is real if its branches point back into itself."""
    if len(data) != ROM_SIZE:
        r.warn("size is 0x%X; the SL6806 mask ROM is 0x%X bytes"
               % (len(data), ROM_SIZE))

    total = inside = 0
    for t in bl_targets(data, 0):
        total += 1
        if 0 <= t < len(data):
            inside += 1
    if total < 500:
        r.bad("only %d branch encodings found - this is not a code image" % total)
        return
    frac = 100.0 * inside / total
    if frac >= 85:
        r.ok("%.1f%% of %d branches resolve inside the ROM (real code)"
             % (frac, total))
    elif frac >= 60:
        r.warn("%.1f%% of %d branches resolve inside the ROM - low; the image "
               "may be partial" % (frac, total))
    else:
        r.bad("only %.1f%% of %d branches resolve inside the ROM - this is not "
              "a valid ROM image" % (frac, total))


def check_sram(data, r):
    """An SRAM dump is trustworthy where its known structures read back."""
    import struct

    if len(data) != SRAM_SIZE:
        r.warn("size is 0x%X; SL6806 SRAM is 0x%X bytes" % (len(data), SRAM_SIZE))

    def ptr_density(lo, hi):
        n = hit = 0
        for a in range(lo, min(hi, len(data)), 4):
            v = struct.unpack_from("<I", data, a)[0]
            n += 1
            if 0 <= v < ROM_SIZE:
                hit += 1
        return (100.0 * hit / n) if n else 0.0

    # Chance level for a uniform-random word landing in the ROM range is 0.01%.
    vec = ptr_density(0x0000, 0x1000)
    if vec >= 50:
        r.ok("vector table at 0x00800000 is %.1f%% ROM-range pointers "
             "(the ROM relocated it here)" % vec)
    else:
        r.bad("vector table page is only %.1f%% ROM-range pointers - the read "
              "did not address SRAM correctly" % vec)

    stk = ptr_density(0x5000, 0x6000)
    if stk >= 1.0:
        r.ok("stack below the ROM's initial SP holds %.1f%% ROM-range return "
             "addresses (the ROM is running)" % stk)
    else:
        r.warn("stack below 0x00806000 holds only %.1f%% ROM-range words; the "
               "ROM may not have been running" % stk)

    # Everything the application installs is absent in bootloader mode. Say so,
    # so an empty region is not mistaken for a bad dump.
    live = []
    for addr, name in ((0x0080E842, "lcd_write_cmd"), (0x0080E8D8, "lcd_write_data"),
                       (0x00811C7C, "gpio_write")):
        o = addr - 0x00800000
        if o + 2 > len(data):
            continue
        hw = struct.unpack_from("<H", data, o)[0]
        if (hw & 0xFF00) == 0xB500 or hw == 0xE92D:
            live.append(name)
    if live:
        r.ok("vendor routines present: %s - unexpected, and worth reporting"
             % ", ".join(live))
    else:
        r.ok("no vendor routines resident (expected in bootloader mode)")


def check_repetition(data, r):
    """The failed-dump signature: the entire file is one block, repeated."""
    for block in (0x40, 0x200, 0x1000):
        if len(data) <= block:
            continue
        first = data[:block]
        if data == first * (len(data) // block) + first[:len(data) % block]:
            r.bad("the entire file is a %d-byte block repeated %d times."
                  % (block, len(data) // block))
            printable = bytes(c if 32 <= c < 127 else 46 for c in first[:64])
            print("        the repeated block is: %r" % printable.decode())
            if b"SMTLINK" in first or b"SSTLINK" in first:
                print()
                print("        That block is a SCSI INQUIRY reply, not flash "
                      "content. The device")
                print("        never performed a read: it answered every "
                      "request with its identity")
                print("        string. This dump contains no firmware at all.")
                print()
                print("        Almost always one of:")
                print("          - the device was in CARD READER mode "
                      "(dump from bootloader mode)")
                print("          - the chip type was not selected "
                      "(pass `chip 6806`)")
                print("          - the wrong --id was given for this chip")
                print()
                print("        See docs/DUMPING.md for the command that works.")
            return True

    # Weaker signal: very few distinct sectors.
    sectors = {}
    for i in range(0, len(data), 0x1000):
        sectors[hashlib.md5(data[i:i + 0x1000]).digest()] = 1
    n = len(data) // 0x1000
    if n and len(sectors) < max(2, n // 100):
        r.bad("only %d distinct 4 KiB sectors in %d - this is not a real dump."
              % (len(sectors), n))
        return True

    r.ok("content varies across the file (not a stuck-response dump)")
    return False


def check_hlkj(data, r):
    if len(data) < 0x60 or data[:4] != HLKJ_MAGIC:
        r.bad("no HLKJ magic at offset 0 - this is not an SL6806 flash image "
              "(or the dump starts at the wrong offset)")
        return
    r.ok("HLKJ bootloader magic at offset 0")

    import struct
    load, entry, hlen = struct.unpack_from("<III", data, 4)
    seglen = struct.unpack_from("<I", data, 0x10)[0]
    seg_crc = struct.unpack_from("<I", data, 0x14)[0] & 0xFFFF
    hdr_crc = struct.unpack_from("<I", data, 0x5C)[0] & 0xFFFF

    print("        load=0x%08X entry=0x%08X hdrlen=0x%X seglen=0x%X"
          % (load, entry, hlen, seglen))

    calc = crc16_ccitt_false(data[0x00:0x5C])
    if calc == hdr_crc:
        r.ok("HLKJ header CRC16 verifies (0x%04X)" % calc)
    else:
        r.bad("HLKJ header CRC16 is 0x%04X, header says 0x%04X"
              % (calc, hdr_crc))

    if 0x60 + seglen <= len(data):
        calc = crc16_ccitt_false(data[0x60:0x60 + seglen])
        if calc == seg_crc:
            r.ok("HLKJ payload CRC16 verifies (0x%04X)" % calc)
        else:
            r.bad("HLKJ payload CRC16 is 0x%04X, header says 0x%04X"
                  % (calc, seg_crc))
    else:
        r.bad("HLKJ segment length 0x%X runs past the end of the file" % seglen)


def check_partitions(data, r):
    if len(data) < PART_TABLE_OFF + 0x200:
        r.warn("file is too short to contain the partition table")
        return

    table = data[PART_TABLE_OFF:PART_TABLE_OFF + 0x200]
    found = [n for n in (b"FIRM", b"PICS", b"FONT") if n in table]

    if len(found) == 3:
        r.ok("partition table at 0x%05X names FIRM, PICS and FONT"
             % PART_TABLE_OFF)
    elif found:
        r.warn("partition table at 0x%05X names only %s"
               % (PART_TABLE_OFF, b", ".join(found).decode()))
    else:
        r.bad("no FIRM/PICS/FONT names at 0x%05X - partition table missing"
              % PART_TABLE_OFF)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("dump")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--rom", action="store_true",
                   help="check a mask ROM dump (0x00000000-0x0007D000)")
    g.add_argument("--sram", action="store_true",
                   help="check an SRAM dump (0x00800000-0x00840000)")
    args = p.parse_args()

    with open(args.dump, "rb") as f:
        data = f.read()

    print("checking %s (%d bytes)" % (args.dump, len(data)))
    r = Report()

    if args.rom or args.sram:
        what = "mask ROM" if args.rom else "SRAM"
        if check_repetition(data, r):
            print("\nverdict: THIS DUMP IS NOT USABLE.")
            return 1
        (check_rom if args.rom else check_sram)(data, r)
        print()
        if r.fatal:
            print("verdict: this %s dump has real problems - do not trust "
                  "analysis based on it." % what)
            return 1
        print("verdict: looks like a valid SL6806 %s dump." % what)
        return 0

    if len(data) == FLASH_SIZE:
        r.ok("size is 4 MiB, the full SL6806 flash")
    elif len(data) < FLASH_SIZE:
        r.warn("size is %.2f MiB; SL6806 flash is 4 MiB, so this is partial. "
               "PICS starts at 0x1DB000 and FONT at 0x2C0000, so a short dump "
               "silently loses them." % (len(data) / 1048576.0))
    else:
        r.warn("size is larger than the 4 MiB SL6806 flash")

    if check_repetition(data, r):
        print("\nverdict: THIS DUMP IS NOT USABLE.")
        return 1

    check_hlkj(data, r)
    check_partitions(data, r)

    print()
    if r.fatal:
        print("verdict: this dump has real problems - do not trust analysis "
              "based on it.")
        return 1

    print("verdict: looks like a valid SL6806 flash image.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
