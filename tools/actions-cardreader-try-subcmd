#!/usr/bin/env python3
"""
actions-cardreader-try-subcmd - send one alternate value for the second
adfu_reboot handshake byte (CDB 0xcb, byte[1]) directly via SG_IO, bypassing
actions_dump/libusb entirely.

WHY THIS EXISTS. `3rd/actions_flash actions_dump --id 20d6:2101 adfu_reboot`
gets as far as a working `0xcc` handshake ("ACTIONSUSBD", byte for byte, GOOD
status), then sends CDB `cb 21 00 00 00 00 00 02 00...` and the device
replies `ff 3d` where the tool wants `ff 00` - and no reboot into ADFU
actually happens (confirmed against dmesg/lsusb). `buf[0]==0xff` still
matched; only the second byte differs. A second, independent implementation
(github.com/nfd/atj2127decrypt) hard-codes the identical `cb 21` pair, which
argues this is a fixed request rather than a selectable per-chip submode -
weak grounds for a sweep, but not zero, and it costs little: this command
has never been observed to touch flash on any chip it has been tried
against. See docs/ACTIONS_CARDREADER.md for the full writeup.

WHY SG_IO INSTEAD OF actions_dump. actions_dump's adfu_reboot does not read
the second command's CSW status packet when the payload doesn't match what
it wants - it just prints "unexpected response" and exits. That leaves a
stale status packet queued on the device's endpoint, which then corrupts the
NEXT actions_dump invocation's first read (this happened - see
docs/ACTIONS_CARDREADER.md). SG_IO goes through the kernel's usb-storage/SCSI
generic layer instead of raw libusb, which frames each command as a
complete, self-contained transaction (CDB, data phase, status) - there is no
equivalent failure mode here, so each run of this script is independent of
whatever the last one returned.

USAGE. One value per run, on purpose - so you can check `lsusb`/`dmesg`
between attempts instead of hammering the device in a blind loop:

    dmesg | grep 'Attached scsi generic'      # find the /dev/sgN node
    sudo tools/actions-cardreader-try-subcmd /dev/sg1 0x21   # reproduces ff 3d
    sudo tools/actions-cardreader-try-subcmd /dev/sg1 0x01

WHAT A RESULT MEANS. `status` is the SCSI command status (0 = GOOD - the
device executed the command without error, regardless of what the payload
says). `data` is the bytes the device sent back. Anything other than the
known `ff 3d`, or the device dropping off `lsusb` right after, is worth
reporting.
"""

import argparse
import ctypes
import fcntl
import os
import sys

SG_IO = 0x2285
SG_DXFER_NONE = -1
SG_DXFER_FROM_DEV = -3


class sg_io_hdr(ctypes.Structure):
    """Mirrors Linux's struct sg_io_hdr (<scsi/sg.h>), stable ABI."""
    _fields_ = [
        ("interface_id", ctypes.c_int),
        ("dxfer_direction", ctypes.c_int),
        ("cmd_len", ctypes.c_ubyte),
        ("mx_sb_len", ctypes.c_ubyte),
        ("iovec_count", ctypes.c_ushort),
        ("dxfer_len", ctypes.c_uint),
        ("dxferp", ctypes.c_void_p),
        ("cmdp", ctypes.c_void_p),
        ("sbp", ctypes.c_void_p),
        ("timeout", ctypes.c_uint),
        ("flags", ctypes.c_uint),
        ("pack_id", ctypes.c_int),
        ("usr_ptr", ctypes.c_void_p),
        ("status", ctypes.c_ubyte),
        ("masked_status", ctypes.c_ubyte),
        ("msg_status", ctypes.c_ubyte),
        ("sb_len_wr", ctypes.c_ubyte),
        ("host_status", ctypes.c_ushort),
        ("driver_status", ctypes.c_ushort),
        ("resid", ctypes.c_int),
        ("duration", ctypes.c_uint),
        ("info", ctypes.c_uint),
    ]


def build_cdb(subcmd, recv_len):
    """CDB `cb <subcmd> 00 00 00 00 00 <recv_len> 00...` - 16 bytes, matching
    the shape captured from actions_dump's adfu_reboot second command."""
    if not (0 <= subcmd <= 0xFF):
        raise ValueError("subcmd must fit in one byte")
    if not (0 <= recv_len <= 0xFF):
        raise ValueError("recv_len must fit in cdb[7]")
    cdb = bytearray(16)
    cdb[0] = 0xCB
    cdb[1] = subcmd
    cdb[7] = recv_len
    return bytes(cdb)


def send_cdb(dev_path, cdb, recv_len, timeout_ms=5000):
    """One SG_IO transaction: send `cdb`, read `recv_len` bytes back.

    Returns (status, sense_bytes, data_bytes). Raises OSError (including
    PermissionError) if the ioctl itself cannot be issued.
    """
    fd = os.open(dev_path, os.O_RDWR)
    try:
        cdb_buf = (ctypes.c_ubyte * len(cdb))(*cdb)
        data_buf = (ctypes.c_ubyte * recv_len)() if recv_len else None
        sense_buf = (ctypes.c_ubyte * 32)()

        hdr = sg_io_hdr()
        hdr.interface_id = ord("S")
        hdr.dxfer_direction = SG_DXFER_FROM_DEV if recv_len else SG_DXFER_NONE
        hdr.cmd_len = len(cdb)
        hdr.mx_sb_len = len(sense_buf)
        hdr.dxfer_len = recv_len
        hdr.dxferp = ctypes.cast(data_buf, ctypes.c_void_p) if data_buf else None
        hdr.cmdp = ctypes.cast(cdb_buf, ctypes.c_void_p)
        hdr.sbp = ctypes.cast(sense_buf, ctypes.c_void_p)
        hdr.timeout = timeout_ms

        fcntl.ioctl(fd, SG_IO, hdr)

        data = bytes(data_buf) if data_buf else b""
        sense = bytes(sense_buf[:hdr.sb_len_wr]) if hdr.sb_len_wr else b""
        return hdr.status, sense, data
    finally:
        os.close(fd)


def describe_result(status, data):
    """Human-readable verdict for a (status, data) pair. Pure, for testing."""
    lines = []
    lines.append("status: 0x%02x (%s)" % (
        status, "GOOD" if status == 0 else "CHECK CONDITION / error"))
    if data:
        lines.append("data (%d bytes): %s" % (len(data), data.hex(" ")))
    if data == bytes([0xFF, 0x00]):
        lines.append("*** matches the accepted reply (ff 00) - check lsusb now ***")
    elif data[:1] == b"\xff":
        lines.append("first byte is 0xff (as with 0x21) but the rest differs "
                     "from the known-accepted ff 00 - not confirmed accepted")
    return "\n".join(lines)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("sg_dev", help="SCSI generic device, e.g. /dev/sg1")
    p.add_argument("subcmd", type=lambda s: int(s, 0),
                   help="byte to send as cdb[1] instead of 0x21 (0x.. or decimal)")
    p.add_argument("--recv-len", type=lambda s: int(s, 0), default=2,
                   help="bytes to request back (default 2, matching 0x21's reply)")
    p.add_argument("--timeout", type=int, default=5000, help="ms")
    args = p.parse_args()

    try:
        cdb = build_cdb(args.subcmd, args.recv_len)
    except ValueError as e:
        sys.exit("error: %s" % e)

    print("CDB: %s" % cdb.hex(" "))

    try:
        status, sense, data = send_cdb(args.sg_dev, cdb, args.recv_len, args.timeout)
    except PermissionError:
        sys.exit("error: permission denied opening %s - run with sudo" % args.sg_dev)
    except OSError as e:
        sys.exit("error: %s" % e)

    print(describe_result(status, data))
    if sense:
        print("sense: %s" % sense.hex(" "))
    return 0


if __name__ == "__main__":
    sys.exit(main())
